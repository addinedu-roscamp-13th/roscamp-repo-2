# Copy to .env and fill in real values. .env is git-ignored.

SECRET_KEY=CHANGE_ME

# MariaDB(labi) 연결 문자열 — async 드라이버 aiomysql 사용.
# 형식: mysql+aiomysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+aiomysql://labi_user:CHANGE_ME@127.0.0.1:3306/labi
# 필요 시 관리자/로봇 DB 를 물리적으로 분리하려면 아래를 개별 지정 (미지정 시 DATABASE_URL 사용).
# ADMIN_DATABASE_URL=
# ROBOT_DATABASE_URL=

OLLAMA_URL=http://127.0.0.1:11434
