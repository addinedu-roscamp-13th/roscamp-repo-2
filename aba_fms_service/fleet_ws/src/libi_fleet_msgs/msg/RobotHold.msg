# 주문 다리 사이에 로봇을 붙잡아 순회로 떠나지 않게 한다.
#
# fleet_node 는 주행 다리만 알아서, 팔 다리가 도는 동안 그 로봇이 유휴로 보인다.
# 그때 순회를 새로 걸면 로봇이 서가를 떠난다 — 팔이 거기서 집어야 하는데.
#
# ⚠️ ttl_sec 은 필수다. 푸는 쪽이 죽으면 로봇이 영영 순회를 못 하기 때문에,
#    fleet_node 가 만료를 읽는 시점에 경고와 함께 스스로 푼다.
string robot
bool hold
float32 ttl_sec     # hold=true 일 때만 의미. 0 이하나 600 초과면 기본 120 으로 클램프
