# ──────────────────────────────────────────────────────────────
# ABA (Arte Book Asistance) — 환경변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 의해 커밋되지 않습니다. (실제 비밀값은 .env 에만)
# ──────────────────────────────────────────────────────────────

# ── ABA DB (aba_service) ──────────────────────────────────────
ABA_DB_HOST=localhost
ABA_DB_PORT=3306
ABA_DB_NAME=aba
ABA_DB_USER=aba
ABA_DB_PASSWORD=change-me
# ORM(SQLAlchemy 등)에서 쓰는 URL (선택)
DATABASE_URL=mysql+asyncmy://aba:change-me@localhost:3306/aba

# ── aba_service (웹 백엔드 / FastAPI) ─────────────────────────
ABA_SERVICE_HOST=0.0.0.0
ABA_SERVICE_PORT=8000
SECRET_KEY=change-me-to-a-random-string

# ── ai_service (비전 AI · UDP 이미지 수신) ────────────────────
AI_SERVICE_UDP_HOST=0.0.0.0
AI_SERVICE_UDP_PORT=9000
# YOLO / Ultralytics 가중치 경로
YOLO_WEIGHTS=./models/best.pt

# ── LiBi AI (AI 챗봇 · MariaDB + Ollama) ─────────────────────
MARIADB_DATABASE=labi
MARIADB_USER=labi
MARIADB_PASSWORD=labi
MARIADB_ROOT_PASSWORD=change-me
LABI_DATABASE_URL=mysql+asyncmy://labi:labi@localhost:3306/labi
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# ── ROS2 / RMF (fleet · controller) ───────────────────────────
# 로봇 도메인과 RMF 도메인을 domain_bridge 로 연결
ROS_DOMAIN_ID=0
RMF_DOMAIN_ID=1
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ── 머신 IP (scripts/ 런처가 참조 — scripts/README.md 참고) ──────
# laptop = FMS·AI 서버가 도는 개발/서버 머신. 로봇은 pinky{1,2,3}.
#   - libi_gui.sh          : PERCEPTION_URL / FMS_URL / ABA_SERVICE_URL 을 LAPTOP_IP 로 채움
#   - ai_follower_service.sh: --drive-host 를 해당 PINKY{N}_IP 로 채움
#   - image-sender.sh      : AI 서버 IP 기본값을 LAPTOP_IP 로
# ⚠️ CycloneDDS 피어는 여기서 자동 구성하지 않는다 — 그건
#    aba_controller/libi_drive_controller/ros_ws/cyclonedds.xml 에서 직접 관리.
LAPTOP_IP=172.30.1.10
PINKY1_IP=
PINKY2_IP=
PINKY3_IP=
