<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS 설정 — 호스트 사이는 유니캐스트 정적 피어, 호스트 안은 멀티캐스트 디스커버리.

  왜 필요한가: 공유기가 멀티캐스트를 막아서 서버(192.168.0.19)와 DDS 디스커버리가
  안 된다. FastDDS 는 ROS_STATIC_PEERS 로 해결했지만, CycloneDDS 는 그 환경변수를
  (버전에 따라) 안 볼 수 있어 여기 XML 로 피어를 직접 지정한다.

  ⚠️ 새 머신/로봇이 추가되면 그 IP 를 아래 <Peers> 에 넣어야 서로 보인다.
  ⚠️ localhost 피어는 같은 Pi 안의 여러 프로세스(nav2·fleet_link·bringup)끼리
     유니캐스트로 디스커버리하기 위해 필요하다 — 절대 빼지 말 것.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true"/>
      </Interfaces>
      <!-- [2026-07-30] `false` → `spdp`. **공유기 우회는 그대로 유지된다.**

           `false` 는 공유기가 멀티캐스트를 막아서 넣은 값인데, 그게 **같은 Pi 안까지**
           막고 있었다. loopback 멀티캐스트는 공유기를 안 지나므로 그 이유가 성립하지
           않는 구간이다. 그런데 이 Pi 에는 참가자가 약 40개라, 멀티캐스트가 없으면
           서로를 **전부 유니캐스트로** 발견한다(40×40 관계). 실측에서 커널 시간이
           `sy 38.4%` 로 유저 시간과 맞먹었고, 그 후보 중 하나가 이것이다.

           `spdp` = **참가자 디스커버리만 멀티캐스트, 데이터는 유니캐스트.**
           호스트 사이는 아래 <Peers> 유니캐스트가 그대로 담당하므로, 공유기가 멀티캐스트를
           막아도 **잃는 게 없다**(멀티캐스트가 더해질 뿐 유니캐스트가 빠지지 않는다).

           ⚠️ 되돌리려면 `false` 로만 바꾸면 된다. 노드가 서로 안 보이면 여기부터 의심하라. -->
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <!-- ⚠️ <Peers> 의 주소는 **살아 있는 것만** 둔다.
           유니캐스트 SPDP 는 목록의 **모든 주소에 주기적으로 패킷을 쏜다.** 응답이 없어도
           계속 보낸다 — 죽은 주소 하나가 참가자 수(약 40)만큼 곱해져 낭비된다.
           2026-07-30 에 이 목록에 지금 망에 없는 주소가 셋 있었다.

           ⚠️ **여기는 폴백일 뿐이다.** 정본은 루트 `.env` 의 `*_IP` 목록이고
           `scripts/_load_env.sh` 가 거기서 `CYCLONEDDS_URI` 를 만든다. 이 파일은
           `.env` 가 없을 때 `libi_pi.sh:83` 이 `file://` 로 집어드는 경우에만 쓰인다.
           **망이 바뀌면 `.env` 를 먼저 고쳐라.** -->
      <Peers>
        <!-- 같은 호스트 내부 프로세스 간 디스커버리 (필수) -->
        <Peer address="localhost"/>
        <!-- [2026-07-31] 망이 192.168.1.x → 172.30.1.x 로 바뀌었다(KT_WiFi_5G_0295). -->
        <Peer address="172.30.1.97"/>    <!-- FMS 서버 / 노트북 -->
        <Peer address="172.30.1.99"/>    <!-- pinky-1 (도메인 117) -->
        <Peer address="172.30.1.95"/>    <!-- pinky-2 (도메인 118) -->
        <Peer address="172.30.1.83"/>    <!-- pinky-3 (도메인 119) -->
        <!-- [비활성] 지난 망들. 그 환경으로 돌아가면 되살린다. 켜 둔 채로는 응답 없는
             곳에 SPDP 를 계속 쏜다.
        <Peer address="192.168.1.10"/>   노트북 (192.168.1.x, 2026-07-30~31)
        <Peer address="192.168.0.19"/>   FMS 서버 (192.168.0.x 시절)
        -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
