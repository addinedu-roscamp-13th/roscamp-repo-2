<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_navigation</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="kyung133851@pinkab.art">mkh</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>navigation2</depend>
  <depend>nav2_bringup</depend>
  <!-- gz_bringup_launch.xml 이 시뮬에도 /cmd_vel 중재자를 띄운다(실기와 같은 배선).
       설정은 pinky_bringup 의 config/twist_mux.yaml 을 그대로 쓴다 — 두 벌로 두면
       시뮬과 실기의 우선순위가 조용히 갈린다. -->
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>pinky_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
